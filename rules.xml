<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="MikeBronnerCleanCode"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Master ruleset for mike-bronner/phpcs-rules. Individual sniff standards get wired in here via rule refs as they land — see CONTRIBUTING.md.</description>

    <arg name="extensions" value="php"/>

    <!--
        Pin sniff behaviour to the package's PHP floor (composer.json requires
        ^8.1) so version-gated Slevomat options (union/intersection hints,
        standalone null/true/false, …) resolve the same on every runtime.
        This value wins over a consumer ruleset's own <config> tag (nested
        rulesets are processed last, so theirs is clobbered); the only
        override that sticks is PHPCS's double-hyphen "runtime-set" CLI
        option: phpcs [..]runtime-set php_version 80200.
    -->
    <config name="php_version" value="80100"/>

    <!--
        Wire individual standards in below as they land. Custom sniffs live in
        the CleanCode standard; Slevomat rules are referenced individually,
        e.g. <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes"/>.
    -->
    <rule ref="./CleanCode/ruleset.xml"/>

    <!-- Constructors: Property Promotion (#47) -->
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>

    <!--
        Code Style: Industry Standards (PSR1/2/12) — #49.
        PHPCS's bundled PSR12 standard includes PSR1 wholesale and implements
        PSR-12, which supersedes PSR-2 (referencing PSR2 alongside it would
        flag PSR12-correct code, e.g. multi-line function declarations).
        Referenced BEFORE the custom clean-code rules below so that any
        same-sniff configuration in a later rule overrides the industry
        baseline — custom standards win where they conflict.

        PSR12.Operators.OperatorSpacing is excluded: it enforces "at least 1
        space" around operators, which the stricter "exactly 1 space"
        Squiz.WhiteSpace.OperatorSpacing / Squiz.Strings.ConcatenationSpacing
        sniffs configured for #35 supersede. They are *different* sniffs, so
        the "same-sniff configuration wins" mechanism above cannot dedupe them
        — left in, both fire and every operator-spacing violation is reported
        twice. The exclude keeps exactly one diagnostic per violation.
    -->
    <rule ref="PSR12">
        <exclude name="PSR12.Operators.OperatorSpacing"/>
    </rule>

    <!--
        Type Hints and Return Types (#45): every method parameter, return
        value, and property carries a native type hint. Only the missing-hint
        codes are enforced; the annotation-centric codes (traversable
        @param/@var specifications, useless-annotation cleanup, less-specific
        native hints) police doc blocks, which the standard does not mandate.
    -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.UselessAnnotation"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.UselessAnnotation"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.LessSpecificNativeTypeHint"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.UselessAnnotation"/>
    </rule>

    <!-- Exceptions (#63): always reference \Throwable when catching, and use
         non-capturing catch when the caught variable is unused. -->
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>
    <!--
        Naming: Casing conventions (#22) — camelCase variables, properties,
        and methods; PascalCase classes, interfaces, traits, and enums.
        SQL/URL/env casing lives in strings and is out of linter scope.

        Only the variable/property sniff is referenced here. The method and
        class-name halves of the standard — PSR1.Methods.CamelCapsMethodName
        and Squiz.Classes.ValidClassName — arrive with the PSR12 ref above,
        which includes PSR1 wholesale, so an explicit ref adds no coverage
        and no configuration (#217). What it did add was ambiguity: sitting
        in this custom-overrides-industry region, a bare re-ref reads as a
        deliberate override of the baseline when it is not one.

        Narrowing the PSR12 ref no longer silently drops these two, either:
        CasingConventionsRulesetTest asserts the exact violation lines they
        produce through rules.xml, so excluding either from PSR12 turns that
        test red. The belt-and-suspenders ref further down is a different
        case — it is documented as deliberate, and keeps its explanation.
    -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <!--
            Squiz requires private properties to carry a leading underscore;
            the clean-code standard wants plain camelCase for all properties.
        -->
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>

    <!-- Line Length (#3): lines should be <=100 characters (warning) and must be <=120 (error). -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="100"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <!--
        Conditionals: No Inline If-Statements (#9) —
        docs/standards/conditionals-no-inline-if-statements.md. PSR12 (above)
        already bundles this sniff; the explicit ref is intentional
        belt-and-suspenders per CONTRIBUTING step 3 (third-party rules a
        standard depends on are wired in explicitly), so the standard stays
        enforced even if the PSR12 baseline is ever narrowed.
    -->
    <rule ref="Generic.ControlStructures.InlineControlStructure"/>

    <!--
        Conditionals: Avoid Conditionals (#12) —
        docs/standards/conditionals-avoid-conditionals.md.

        The custom CleanCode.Conditionals.AvoidConditionals sniff is picked up
        automatically via the ./CleanCode/ruleset.xml ref above. It warns once
        per if/elseif/ternary/switch, detection only — no token-based sniff can
        judge whether a given branch was avoidable.

        The one shape that does have a safe mechanical rewrite is the
        boolean-return if (`if ($x) { return true; } return false;`), and
        Slevomat already implements that fixer exactly, including the guard
        this standard needs: it only rewrites when the condition itself already
        evaluates to a boolean, so the fix never changes a method's return
        type. No custom fixer is written for it.

        The type is lowered from Slevomat's error to a warning so the whole
        standard speaks at one severity. "Avoid where possible" is advisory —
        it must not fail a consumer's build — while phpcbf still applies the
        fix, since fixability is independent of message type. Applying it
        deletes the if, so the AvoidConditionals warning on that line goes with
        it.
    -->
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessIfConditionWithReturn">
        <type>warning</type>
    </rule>

    <!-- Use Statements: No Unused Entries (#68). searchAnnotations keeps
         imports referenced only in docblocks (@param, @throws, ...) from
         being treated as unused — those references are live, not dead code. -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>

    <!--
        Use Statements: Sort Alphabetically (#67) —
        docs/standards/use-statements-sort-alphabetically.md.

        Three sniffs, because AlphabeticallySortedUses alone is defeatable.
        It stops checking a file entirely as soon as it meets a group use
        (`use App\Nested\{Alpha, Beta};`), and it reads only the first type of
        a comma-separated use (`use App\Zulu, App\Alpha;`) — so either syntax
        lets a plainly unsorted file exit clean. DisallowGroupUse and
        MultipleUsesPerLine reject both syntaxes outright, which closes those
        two bypasses and keeps the standard fail-closed.

        Defaults are kept deliberately: psr12Compatible="true" orders the
        class, function, and constant imports as three groups in that order,
        and caseSensitive="false" compares names the way a reader scans them.
    -->
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.DisallowGroupUse"/>
    <rule ref="SlevomatCodingStandard.Namespaces.MultipleUsesPerLine"/>

    <!--
        Arrays: Operator spacing & line breaks (#35) —
        docs/standards/arrays-operator-spacing-and-line-breaks.md.

        Binary-operator and concatenation spacing (exactly 1 space each side)
        are enforced by configuring two bundled Squiz sniffs; the not-operator
        spacing and the operator line-break placement are custom CleanCode
        sniffs (CleanCode.Operators.*), picked up automatically via the
        ./CleanCode/ruleset.xml ref above.

        ignoreNewlines="true" is required on both spacing sniffs: without it
        they would flag operators that lead a wrapped continuation line (the
        very layout the line-break standard mandates). Newline placement is
        owned by CleanCode.Operators.OperatorLineBreak instead.
    -->
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
            <!-- Enforce a space before assignment too; the standard wants 1
                 space each side, not alignment padding. -->
            <property name="ignoreSpacingBeforeAssignments" value="false"/>
        </properties>
    </rule>
    <rule ref="Squiz.Strings.ConcatenationSpacing">
        <properties>
            <property name="spacing" value="1"/>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>

    <!--
        Arrays: Array Accessors (#33) —
        docs/standards/arrays-array-accessors.md.

        Values are read with data_get() rather than by direct element
        ($array['key']) or property ($object->property) access. No PHPCS or
        Slevomat sniff expresses this Laravel-specific rule, so it is the
        custom CleanCode.Arrays.ArrayAccessors sniff, picked up automatically
        via the ./CleanCode/ruleset.xml ref above — no per-sniff registration
        is needed, and tests/Standards/ArrayAccessorsTest.php asserts the sniff
        resolves from this master ruleset.

        Detection only: rewriting a chain to a dotted data_get() path changes
        meaning when a key contains a dot, and data_get() is a Laravel helper,
        so an auto-fix cannot be applied safely outside a Laravel application.
    -->

    <!--
        Dependency Injection (#72) —
        docs/standards/dependency-injection.md.

        The custom CleanCode.Classes.DisallowConstructorInstantiation sniff is
        picked up automatically via the ./CleanCode/ruleset.xml ref above; this
        comment records that no scoping is wanted. No PHPCS or Slevomat sniff
        reports instantiation by location: Squiz.Objects.ObjectInstantiation
        requires a new to be assigned/returned rather than used bare,
        PSR12.Classes.ClassInstantiation and Slevomat's NewWithParentheses /
        NewWithoutParentheses police the parentheses, and Slevomat's
        constructor sniffs speak about property promotion. It warns once per
        new inside the body of a __construct a class-like scope holds,
        detection only: swapping an instantiation for an injected parameter
        changes the class's signature and every call site. Whatever a throw
        raises is exempt in full, however the expression is spelled.

        Only that slice is enforced. Whether a collaborator warrants injection
        at all needs the whole application's wiring, which a single-file token
        scan cannot see, so the rest of the standard stays with code review
        (#176 records how the slice was scoped).
    -->

    <!--
        Models: Persistence Methods (Repository Pattern) (#37) —
        docs/standards/models-persistence-methods-repository-pattern.md.

        The custom CleanCode.Models.DisallowExternalPersistenceCalls sniff is
        picked up automatically via the ./CleanCode/ruleset.xml ref above; this
        block only scopes it. Factory chains (User::factory()->create()) make
        generic CRUD calls idiomatic in tests, so the sniff stays out of test
        paths.
    -->
    <rule ref="CleanCode.Models.DisallowExternalPersistenceCalls">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!--
        Models: Eager Loading (#74) — docs/standards/models-eager-loading.md.

        Two custom sniffs carry the token-visible slices of this standard, and
        both are picked up automatically via the ./CleanCode/ruleset.xml ref
        above; this comment records that no scoping is wanted for either.

        CleanCode.Models.RequireLazyLoadingPrevention only ever speaks about a
        class named in its serviceProviderClasses property (default:
        AppServiceProvider), so it is already silent everywhere else, tests
        included.

        CleanCode.Models.DisallowAlwaysOnEagerLoading (#153) only speaks about a
        class extending a model-shaped parent, and a populated $with bloats
        every query the same way wherever the model is declared — there is no
        test-path idiom that makes it legitimate, unlike the factory chains that
        keep DisallowExternalPersistenceCalls out of tests above.
    -->

    <!--
        Testing: Development Process (TDD) (#57), classes-only slice (#129) —
        docs/standards/testing-development-process-tdd.md.

        The custom CleanCode.Files.NoProceduralCode sniff is picked up
        automatically via the ./CleanCode/ruleset.xml ref above; this block only
        scopes it. Nothing shipped already covers the case: PSR12 above bundles
        PSR1 wholesale, and PSR1.Files.SideEffects forbids only *mixing* a
        declaration with side effects, so a file that is nothing but procedural
        code declares no symbol and passes it silently. Slevomat's whole
        standard was run against
        tests/fixtures/NoProceduralCodeSniff/failing.php and reported nothing
        about the file's structure either.

        Scoped with <include-pattern> rather than a list of exclusions, because
        the standard is an allow-list: source directories only. Entry points
        (public/index.php, artisan), config files (a top-level return []),
        route files, and pre-Laravel-9-style migrations (return new class …)
        are legitimately procedural, and all of them live outside src/ and
        app/. A consuming project that keeps its classes elsewhere adds its own
        <include-pattern> for that path.

        Detection only: wrapping loose statements in a class decides which
        class, which method, and which visibility, so there is no mechanical
        rewrite.
    -->
    <rule ref="CleanCode.Files.NoProceduralCode">
        <include-pattern>*/src/*</include-pattern>
        <include-pattern>*/app/*</include-pattern>
    </rule>

    <!--
        PHPMD Design: EvalExpression (#107) — docs/phpmd/design-evalexpression.md.

        Squiz.PHP.Eval listens for T_EVAL and reports every eval() expression,
        which is exactly PHPMD's EvalExpression detection; no custom sniff is
        needed. The sniff has no fixer, matching PHPMD (there is no mechanical
        rewrite of an eval'd string into standard code).

        The severity is raised from the sniff's built-in warning to an error so
        the mapping matches PHPMD, where an EvalExpression violation fails the
        run. A warning would leave phpcs exiting 0 on eval() usage, so phpmd
        would still have to run separately for this rule.
    -->
    <rule ref="Squiz.PHP.Eval">
        <type>error</type>
    </rule>

    <!--
        PHPMD CleanCode: BooleanArgumentFlag (#76) —
        docs/phpmd/cleancode-booleanargumentflag.md.

        No existing PHPCS or Slevomat sniff expresses PHPMD's
        BooleanArgumentFlag. The three nearest candidates were run against
        tests/fixtures/DisallowBooleanArgumentFlagSniff/failing.php and each
        reported nothing on its fifteen boolean flag arguments:
        SlevomatCodingStandard.Functions.UselessParameterDefaultValue (a
        default that can never be used), Squiz.PHP.DisallowBooleanStatement (a
        boolean operator forming a whole statement), and
        Generic.CodeAnalysis.UnusedFunctionParameter (a parameter no body
        reads). So this is the custom CleanCode.Functions.DisallowBooleanArgumentFlag
        sniff, picked up automatically via the ./CleanCode/ruleset.xml ref
        above — no per-sniff registration is needed, and
        tests/Standards/DisallowBooleanArgumentFlagTest.php asserts the sniff
        resolves from this master ruleset.

        No <properties> are configured. PHPMD ships this rule with both of its
        properties empty (exceptions, ignorepattern), so nothing is exempt out
        of the box — constructors included — and the sniff's defaults match.
        A consuming ruleset that already tunes PHPMD's rule can paste the same
        two values here: both are spelled and matched exactly as PHPMD spells
        and matches them.

        Unlike Squiz.PHP.Eval and VariableAnalysis below, no <type> override is
        needed: the sniff raises errors already, so a violation fails a phpcs
        run the way it fails a phpmd run.

        Stricter than PHPMD on three shapes, and never looser. A parameter
        declared `bool` with no default value is reported (PHPMD inspects only
        a parameter's default value); so is a closure at file scope, and a
        closure written inside a method the ignorepattern exempts (PHPMD
        reaches a closure only through its enclosing method, and tests the
        pattern against that method's name). All three are true defects and are
        kept, pinned by tests/fixtures/DisallowBooleanArgumentFlagSniff/
        divergences.php and configured.php, and set out in
        docs/phpmd/cleancode-booleanargumentflag.md.

        Detection only: removing a flag argument splits the callee in two and
        rewrites every call site, which is a design change with no mechanical
        rewrite. PHPMD offers no fix either.
    -->

    <!--
        PHPMD CleanCode: UndefinedVariable (#85) —
        docs/phpmd/cleancode-undefinedvariable.md.
        PHPMD UnusedCode: UnusedLocalVariable (#118) —
        docs/phpmd/unusedcode-unusedlocalvariable.md.

        Two PHPMD rules, one sniff. Neither has a PHPCS/Slevomat equivalent;
        the well-known external standard sirbrillig/phpcs-variable-analysis
        covers both through its single VariableAnalysis.CodeAnalysis.
        VariableAnalysis sniff. They share this one <rule> block because a
        sniff has a single set of properties: two blocks configuring the same
        class would silently fight over them.

        The sniff emits six codes. Three are kept, one concern each:

        - UndefinedVariable      → #85. A read of a name the scope never
                                   assigns (`echo $x;`).
        - UndefinedUnsetVariable → #85. The same read inside `unset($x);`.
        - UnusedVariable         → #118. A name assigned and never read.

        The other three are excluded rather than shipped as a side effect —
        each is a separate concern with no PHPMD counterpart:

        - VariableRedeclaration → redeclaring a variable that *is* defined is
                                  the opposite of using an undefined one.
        - SelfOutsideClass      → a self:: scope error, not a variable.
        - StaticOutsideClass    → a static:: scope error, not a variable.

        As with Squiz.PHP.Eval above, the severity is raised from the sniff's
        built-in warning to an error: PHPMD fails a run on either rule, and a
        warning would leave phpcs exiting 0, so phpmd would still have to run
        separately for them.

        Detection only, for both rules. An undefined variable has no safe
        machine-derivable value to substitute, and deleting an unused
        assignment can drop a side effect in the expression that produced it,
        so neither code carries a fixer hook.

        The properties below exist only for UnusedLocalVariable —
        UndefinedVariable has no thresholds, and the sniff's defaults already
        treat superglobals, $this, and `global`/`static` declarations as
        defined. Each is set to make the sniff's UnusedVariable code answer
        the question PHPMD's UnusedLocalVariable asks, no more:

        - allowUnusedFunctionParameters=true — PHPMD splits formal parameters
          into its own UnusedFormalParameter rule (#120): UnusedLocalVariable
          drops them in removeParameters(), and skips any node whose parent is
          a FormalParameter. The sniff has no such split — one UnusedVariable
          code covers locals and parameters alike — so parameters are silenced
          here and #120 flips this to false when it lands.
        - allowUnusedForeachVariables=false — matches PHPMD's own default for
          allow-unused-foreach-variables, so an unused foreach key or value is
          flagged. Note the sniff's default is true, hence the explicit set.
        - allowUnusedVariablesInFileScope=true — PHPMD's rule is FunctionAware
          and MethodAware only, so it never looks at a file's top-level scope.
          The sniff does by default; this restores parity.

        Not a drop-in match for PHPMD on either rule, and no property makes it
        one. Every divergence is pinned by a fixture and set out in the two
        docs above:

        - UndefinedVariable is stricter on a read placed above its own
          assignment and on a closure local read outside its closure, because
          the sniff tracks statement order and closure scope where PHPMD asks
          only whether the method assigns the name anywhere. Both extra
          reports are true defects, so they are kept.
        - UnusedVariable reports every assignment to an unused name, where
          PHPMD reports the name once. Same defect, more lines.
        - A name assigned on one branch and read unconditionally after it is
          missed by both tools and stays code review.

        Fixtures: tests/fixtures/VariableAnalysisSniff/divergences.php (#85)
        and unused-locals-divergences.php (#118).
    -->
    <rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
        <type>error</type>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.VariableRedeclaration"/>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.SelfOutsideClass"/>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.StaticOutsideClass"/>
        <properties>
            <property name="allowUnusedFunctionParameters" value="true"/>
            <property name="allowUnusedForeachVariables" value="false"/>
            <property name="allowUnusedVariablesInFileScope" value="true"/>
        </properties>
    </rule>
</ruleset>
