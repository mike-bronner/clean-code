<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="MikeBronnerCleanCode"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Master ruleset for mike-bronner/phpcs-rules. Individual sniff standards get wired in here via rule refs as they land — see CONTRIBUTING.md.</description>

    <arg name="extensions" value="php"/>

    <!--
        Wire individual standards in below as they land. Custom sniffs live in
        the CleanCode standard; Slevomat rules are referenced individually,
        e.g. <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes"/>.
    -->
    <rule ref="./CleanCode/ruleset.xml"/>

    <!-- No Dead Code (mikebronner.dev/clean-code): no commented-out or unused
         code. Unused private methods/properties are covered by the custom
         CleanCode.DeadCode.UnusedPrivateElements sniff above (Slevomat's
         Classes.UnusedPrivateElements was removed in slevomat/coding-standard
         7.0). -->
    <rule ref="Squiz.PHP.CommentedOutCode"/>
    <rule ref="SlevomatCodingStandard.Functions.UnusedParameter"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <!-- Imports referenced only in doc-block annotations are used —
                 without this, phpcbf would strip them and break the docs. -->
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
</ruleset>
