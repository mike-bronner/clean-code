<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="MikeBronnerCleanCode"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Master ruleset for mike-bronner/phpcs-rules. Individual sniff standards get wired in here via rule refs as they land — see CONTRIBUTING.md.</description>

    <arg name="extensions" value="php"/>

    <!--
        Wire individual standards in below as they land. Custom sniffs live in
        the CleanCode standard; Slevomat rules are referenced individually,
        e.g. <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes"/>.
    -->
    <rule ref="./CleanCode/ruleset.xml"/>

    <!--
        Code Style: Industry Standards (PSR1/2/12) — #49.
        PHPCS's bundled PSR12 standard includes PSR1 wholesale and implements
        PSR-12, which supersedes PSR-2 (referencing PSR2 alongside it would
        flag PSR12-correct code, e.g. multi-line function declarations).
        Referenced BEFORE the custom clean-code rules below so that any
        same-sniff configuration in a later rule overrides the industry
        baseline — custom standards win where they conflict.
    -->
    <rule ref="PSR12"/>

    <!-- Exceptions (#63): always reference \Throwable when catching, and use
         non-capturing catch when the caught variable is unused. -->
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>
    <!--
        Naming: Casing conventions (#22) — camelCase variables, properties,
        and methods; PascalCase classes, interfaces, traits, and enums.
        SQL/URL/env casing lives in strings and is out of linter scope.
    -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <!--
            Squiz requires private properties to carry a leading underscore;
            the clean-code standard wants plain camelCase for all properties.
        -->
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName"/>
    <rule ref="Squiz.Classes.ValidClassName"/>
</ruleset>
