<?php

declare(strict_types=1);

$a = 1;
$b = true;
$c = false;
$s = 'x';

// Compliant: arithmetic assignment.
$a = 1;
$a += 1;
$a -= 1;
$a /= 2;
$a *= 2;
$a %= 2;
$a **= 2;

// Compliant: bitwise assignment.
$a &= 1;
$a |= 1;
$a ^= 1;
$a <<= 1;
$a >>= 1;

// Compliant: other assignment.
$s .= 'y';
$s ??= 'z';

// Compliant: logical operators.
$r = $b && $c;
$r = $b || $c;
$r = ($b and $c);
$r = ($b or $c);
$r = ($b xor $c);
$r = ! $b;
$r = ! ! $b;

// Compliant: string concatenation.
$s = 'a' . 'b';

// Compliant: multi-line string concatenation.
$s = 'a'
    . 'b'
    . 'c';
$s = 'a' .
    'b';

// Compliant: chained assignment.
$a = $b = $c;

// Violations: arithmetic assignment.
$a = 1;
$a = 1;
$a = 1;
$a += 1;
$a += 1;
$a += 1;
$a -= 1;
$a -= 1;
$a -= 1;
$a /= 2;
$a /= 2;
$a /= 2;
$a *= 2;
$a *= 2;
$a *= 2;
$a %= 2;
$a %= 2;
$a %= 2;
$a **= 2;
$a **= 2;
$a **= 2;

// Violations: bitwise assignment.
$a &= 1;
$a &= 1;
$a &= 1;
$a |= 1;
$a |= 1;
$a |= 1;
$a ^= 1;
$a ^= 1;
$a ^= 1;
$a <<= 1;
$a <<= 1;
$a <<= 1;
$a >>= 1;
$a >>= 1;
$a >>= 1;

// Violations: other assignment.
$s .= 'y';
$s .= 'y';
$s .= 'y';
$s ??= 'z';
$s ??= 'z';
$s ??= 'z';

// Violations: logical operators.
$r = $b && $c;
$r = $b && $c;
$r = $b && $c;
$r = $b || $c;
$r = $b || $c;
$r = $b || $c;
$r = ($b) and ($c);
$r = ($b) and ($c);
$r = ($b) and ($c);
$r = ($b) or ($c);
$r = ($b) or ($c);
$r = ($b) or ($c);
$r = ($b) xor ($c);
$r = ($b) xor ($c);
$r = ($b) xor ($c);
$r = ! $b;
$r = ! $b;
$r = ! ! $b;

// Violations: string concatenation.
$s = 'a' . 'b';
$s = 'a' . 'b';
$s = 'a' . 'b';

// Violations: chained assignment.
$a = $b = $c;
