<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="CleanCode"
         xsi:noNamespaceSchemaLocation="../vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Custom sniffs implementing the clean-code standards defined at mikebronner.dev/clean-code. Every sniff in this standard's Sniffs/ directory is included automatically when the standard is referenced.</description>

    <!--
        OrdinalIndex is test instrumentation. Its config gate is not enough on
        its own: the phpcs config-set command persists into the install's shared
        CodeSniffer.conf, so a stale one leaks this warning into every later run
        against that install, which a consumer cannot diagnose from their own
        repository.

        The severity must be declared here, not in rules.xml: this file is
        independently loadable, so a consumer may point a standard argument
        straight at it. rules.xml must not re-declare a nonzero severity for the
        code after referencing this file, or the hazard reopens. A consumer's
        own ruleset can, which is how
        tests/Standards/NumberOfChildrenTest.php reads the numbers back.
    -->
    <rule ref="CleanCode.Metrics.NumberOfChildren.OrdinalIndex">
        <severity>0</severity>
    </rule>
</ruleset>
