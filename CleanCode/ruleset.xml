<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="CleanCode"
         xsi:noNamespaceSchemaLocation="../vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>The clean-code standard defined at mikebronner.dev/clean-code, entire: the custom sniffs in this directory plus the bundled, Slevomat and third-party rules wired in below. Referenced by name — &lt;rule ref="CleanCode"/&gt; — and the only standard this package installs. See CONTRIBUTING.md.</description>

    <!-- Blade views -->
    <arg name="extensions" value="php,blade.php/php"/>
    <rule ref="Internal.NoCodeFound">
        <exclude-pattern>*\.blade\.php</exclude-pattern>
    </rule>

    <!-- PHP version -->
    <config name="php_version" value="80300"/>

    <!-- Test instrumentation -->
    <rule ref="CleanCode.Metrics.NumberOfChildren.OrdinalIndex">
        <severity>0</severity>
    </rule>

    <!-- Constructors -->
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>

    <!-- Code Style -->
    <rule ref="PSR12">
        <exclude name="PSR12.Classes.ClassInstantiation"/>
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <exclude name="PSR2.Methods.FunctionCallSignature.Indent"/>
        <exclude name="PSR2.Classes.ClassDeclaration"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace"/>
    </rule>

    <!-- Type Hints -->
    <rule ref="CleanCode.TypeHints.PropertyTypeHint">
        <exclude name="CleanCode.TypeHints.PropertyTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="CleanCode.TypeHints.PropertyTypeHint.UselessAnnotation"/>
    </rule>

    <!-- Exceptions -->
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>

    <!-- Naming -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>

    <!-- Methods -->
    <rule ref="CleanCode.TypeHints.ParameterTypeHint">
        <exclude name="CleanCode.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="CleanCode.TypeHints.ParameterTypeHint.UselessAnnotation"/>
        <properties>
            <property name="enableObjectTypeHint" value="true"/>
            <property name="enableMixedTypeHint" value="true"/>
            <property name="enableUnionTypeHint" value="true"/>
            <property name="enableIntersectionTypeHint" value="true"/>
            <property name="enableStandaloneNullTrueFalseTypeHints" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.UselessAnnotation"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.LessSpecificNativeTypeHint"/>
        <properties>
            <property name="enableObjectTypeHint" value="true"/>
            <property name="enableStaticTypeHint" value="true"/>
            <property name="enableMixedTypeHint" value="true"/>
            <property name="enableUnionTypeHint" value="true"/>
            <property name="enableIntersectionTypeHint" value="true"/>
            <property name="enableNeverTypeHint" value="true"/>
            <property name="enableStandaloneNullTrueFalseTypeHints" value="true"/>
        </properties>
    </rule>

    <!-- Line Length -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="100"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <!-- No Dead Code -->
    <rule ref="Squiz.PHP.CommentedOutCode"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>

    <!-- Conditionals -->
    <rule ref="Generic.ControlStructures.InlineControlStructure"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessIfConditionWithReturn">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireTernaryOperator"/>

    <!-- Use Statements -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.DisallowGroupUse"/>
    <rule ref="SlevomatCodingStandard.Namespaces.MultipleUsesPerLine"/>

    <!-- Arrays -->
    <rule ref="CleanCode.Operators.BinaryOperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
            <property name="ignoreSpacingBeforeAssignments" value="false"/>
        </properties>
    </rule>
    <rule ref="Squiz.Strings.ConcatenationSpacing">
        <properties>
            <property name="spacing" value="1"/>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>

    <!-- Models -->
    <rule ref="CleanCode.Models.DisallowExternalPersistenceCalls">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="CleanCode.Models.DisallowChainedPropertyFetch">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Testing -->
    <rule ref="CleanCode.Files.NoProceduralCode">
        <include-pattern>*/src/*</include-pattern>
        <include-pattern>*/app/*</include-pattern>
    </rule>
    <rule ref="CleanCode.Testing.NoFirstPartyMocks">
        <properties>
            <property name="firstPartyNamespaces" type="array">
                <element value="App"/>
            </property>
        </properties>
    </rule>

    <!-- PHPMD Design -->
    <rule ref="Squiz.PHP.Eval">
        <type>error</type>
    </rule>

    <!-- Pattern -->
    <rule ref="CleanCode.Pattern.TooManyInterfaceMethods">
        <properties>
            <property name="maxMethods" value="5"/>
        </properties>
    </rule>

    <!-- PHPMD Clean Code -->
    <rule ref="Generic.PHP.NoSilencedErrors">
        <properties>
            <property name="error" value="true"/>
        </properties>
    </rule>
    <rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
        <type>error</type>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.VariableRedeclaration"/>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.SelfOutsideClass"/>
        <exclude name="VariableAnalysis.CodeAnalysis.VariableAnalysis.StaticOutsideClass"/>
        <properties>
            <property name="allowUnusedFunctionParameters" value="true"/>
            <property name="allowUnusedForeachVariables" value="false"/>
            <property name="allowUnusedVariablesInFileScope" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly">
        <properties>
            <property name="allowFullyQualifiedGlobalFunctions" value="true"/>
            <property name="allowFullyQualifiedGlobalConstants" value="true"/>
        </properties>
    </rule>

    <!-- PHPMD Code Size -->
    <rule ref="CleanCode.Classes.ExcessiveClassLength">
        <properties>
            <property name="minimum" value="1000"/>
            <property name="ignoreWhitespace" value="false"/>
        </properties>
    </rule>

    <!-- PHPMD Design -->
    <rule ref="Generic.PHP.DiscourageGoto.Found">
        <message>Use of the goto construct is disallowed; replace it with standard control structures and separate methods.</message>
        <type>error</type>
    </rule>

    <!-- PHPMD Naming -->
    <rule ref="Generic.NamingConventions.ConstructorName">
        <exclude name="Generic.NamingConventions.ConstructorName.OldStyleCall"/>
    </rule>

    <!-- PHPMD Code Size -->
    <rule ref="CleanCode.CodeSize.TooManyMethods">
        <properties>
            <property name="maxmethods" value="25"/>
            <property name="ignorepattern" value="(^(set|get|is|has|with))i"/>
        </properties>
    </rule>

    <!-- Clear Code -->
    <rule ref="Generic.CodeAnalysis.AssignmentInCondition"/>
    <rule ref="Generic.CodeAnalysis.AssignmentInCondition.Found">
        <type>error</type>
    </rule>
    <rule ref="Squiz.PHP.DisallowMultipleAssignments"/>

    <!-- Operators -->
    <rule ref="Generic.WhiteSpace.IncrementDecrementSpacing"/>
    <rule ref="Squiz.WhiteSpace.ObjectOperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>
    <rule ref="Squiz.Arrays.ArrayBracketSpacing"/>

    <!-- Debt -->
    <rule ref="Generic.Commenting.Todo"/>
    <rule ref="Generic.Commenting.Fixme">
        <type>warning</type>
    </rule>
</ruleset>
