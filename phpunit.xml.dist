<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         beStrictAboutTestsThatDoNotTestAnything="false"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <!--
            A <directory> defaults to suffix="Test.php", which is what keeps
            the deliberately malformed fixtures under these directories from
            being collected as tests.
        -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <!--
            tests/Helpers/ covers CleanCode/Helpers/. It is not tests/Helpers.php,
            which holds the Pest helper functions every suite calls.
        -->
        <testsuite name="Helpers">
            <directory>tests/Helpers</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Rules">
            <directory>tests/Rules</directory>
        </testsuite>
        <testsuite name="Ruleset">
            <directory>tests/Ruleset</directory>
        </testsuite>
        <testsuite name="Standards">
            <directory>tests/Standards</directory>
        </testsuite>
        <testsuite name="Support">
            <directory>tests/Support</directory>
        </testsuite>
    </testsuites>
</phpunit>
