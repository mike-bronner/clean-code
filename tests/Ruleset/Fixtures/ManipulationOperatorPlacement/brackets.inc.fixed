<?php

declare(strict_types=1);

// A trailing operator wrapped inside a control-structure condition, a
// call-argument list, or an array literal must still be flagged, and the fixer
// must lead the continuation line one level past the statement's *root* line —
// never one level deeper because the operator sits inside a bracket.
if (
    $isActive
    && $isVerified
) {
    //
}

$result = someCall(
    $value
    + $four
);

$array = [
    $base
    - $discount,
];

// A bracketed operator nested inside an indented block anchors on the block's
// statement line, so its continuation indent is one level past that — not past
// the enclosing parenthesis.
function check(bool $left, bool $right): bool
{
    return between(
        $left
        || $right
    );
}
