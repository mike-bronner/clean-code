<?php

declare(strict_types=1);

namespace App\Fixtures;

function passiveOperators(int $a, object $obj, array $arr, string $dir): void
{
    $identity = +$a;
    $negation = -$a;
    $postIncrement = $a++;
    $preIncrement = ++$a;
    $postDecrement = $a--;
    $preDecrement = --$a;
    $suppressed = @file_get_contents('x');
    $executed = `ls`;
    $interpolated = `ls $dir`;
    $element = $arr[0];
    $chainedElement = $arr[0][1];
    $property = $obj->name;
    $chainedProperty = $obj->name->length;
    $signOnIncrement = -++$a;
    $signOnDecrement = +--$a;
    $binaryPlus = $a + $a;
    $binaryMinus = $a - $a;
    $binaryAfterPostfix = $a++ + $a;
}

// Short-echo template context: `<?=` immediately precedes the sign, so `-` is
// unary negation and must sit flush against its operand.
?>
<?= -$total ?>
