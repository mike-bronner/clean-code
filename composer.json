{
    "name": "mike-bronner/phpcs-rules",
    "description": "PHPCS ruleset and custom sniffs enforcing the clean-code standards defined at mikebronner.dev/clean-code.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "keywords": [
        "phpcs",
        "php_codesniffer",
        "coding-standard",
        "static-analysis",
        "clean-code"
    ],
    "require": {
        "php": "^8.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "sirbrillig/phpcs-variable-analysis": "^3.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "require-dev": {
        "pestphp/pest": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "MikeBronner\\CleanCode\\": "CleanCode/"
        },
        "files": [
            "CleanCode/Support/BackportedTokens.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MikeBronner\\CleanCode\\Tests\\": "tests/",
            "MikeBronner\\CleanCode\\Tools\\": "tools/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 --extensions=php --ignore=*/fixtures/* CleanCode tests",
        "lint:self": "phpcs --standard=phpcs.self.xml",
        "test": "pest"
    }
}
