{
    "name": "mike-bronner/clean-code",
    "description": "PHPCS ruleset and custom sniffs enforcing the clean-code standards defined at mikebronner.dev/clean-code.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "keywords": [
        "phpcs",
        "php_codesniffer",
        "coding-standard",
        "static-analysis",
        "clean-code"
    ],
    "require": {
        "php": "^8.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "sirbrillig/phpcs-variable-analysis": "^3.0",
        "slevomat/coding-standard": "^8.23",
        "squizlabs/php_codesniffer": "^4.0.2"
    },
    "require-dev": {
        "pestphp/pest": "^4.0 || ^5.0",
        "orchestra/testbench": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "MikeBronner\\CleanCode\\": "CleanCode/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikeBronner\\CleanCode\\Tests\\": "tests/",
            "MikeBronner\\CleanCode\\Tools\\": "tools/",
            "MikeBronner\\CleanCode\\Tests\\Ancestors\\": "tests/fixtures/_ancestors/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.lint.xml",
        "lint:self": "phpcs --standard=phpcs.self.xml",
        "test": "pest"
    }
}
