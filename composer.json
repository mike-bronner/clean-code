{
    "name": "mike-bronner/phpcs-rules",
    "description": "PHPCS ruleset and custom sniffs enforcing the clean-code standards defined at mikebronner.dev/clean-code.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "keywords": [
        "phpcs",
        "php_codesniffer",
        "coding-standard",
        "static-analysis",
        "clean-code"
    ],
    "require": {
        "php": "^8.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "MikeBronner\\CleanCode\\": "CleanCode/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikeBronner\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 --extensions=php CleanCode tests",
        "test": "phpunit"
    }
}
